#include "xparameters.h"
#include "xil_io.h"
#include <stdio.h>
#include <unistd.h>

#define IP_BASE_ADDR XPAR_MYIP_0_S00_AXI_BASEADDR

int main() {
    printf("Hello AXI IP\n");

    printf("Try write count_limit...\n");
    Xil_Out32(IP_BASE_ADDR + 0x00, 100);
    printf("Write done.\n");

    for (int i = 0; i < 100; i++) {
        printf("Reading...\n");
        unsigned int val = Xil_In32(IP_BASE_ADDR + 0x04);
        printf("[%02d] count_value: %u\n", i, val);
        usleep(50000);  // 50ms
    }

    printf("Loop done\n");
    while (1);
    return 0;
}
