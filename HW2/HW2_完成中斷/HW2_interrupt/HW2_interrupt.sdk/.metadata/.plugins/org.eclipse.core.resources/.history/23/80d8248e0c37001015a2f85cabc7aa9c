#include "xparameters.h"
#include "xil_io.h"
#include <stdio.h>
#include <unistd.h>

#define IP_BASE_ADDR XPAR_MYIP_0_S00_AXI_BASEADDR
#define INTR_BASE_ADDR XPAR_HW2_INTERRUPT_0_S_AXI_INTR_BASEADDR

// Interrupt controller register offsets
#define GIER 0x00  // Global Interrupt Enable Register
#define IER  0x04  // Interrupt Enable Register
#define ISR  0x08  // Interrupt Status Register
#define IAR  0x0C  // Interrupt Acknowledge Register
#define IPR  0x10  // Interrupt Pending Register

int main() {
    printf("=== Starting AXI IP Counter Test with Interrupt ===\n");

    // Step 1: Configure interrupt controller
    printf("Configuring interrupt controller...\n");
    Xil_Out32(INTR_BASE_ADDR + GIER, 0x1); // Enable global interrupt
    Xil_Out32(INTR_BASE_ADDR + IER, 0x1);  // Enable interrupt 0
    Xil_Out32(INTR_BASE_ADDR + IAR, 0x1);  // Clear any pending interrupts

    // Step 2: Write count_max to slv_reg0
    unsigned int count_max = 20;
    printf("Writing count_max: %u to slv_reg0 (offset 0x00)\n", count_max);
    Xil_Out32(IP_BASE_ADDR, count_max);
    printf("Write completed. Please press the button to start counting...\n");

    // Step 3: Poll slv_reg1 (count_value) and slv_reg2 (done)
    unsigned int count_value = 0;
    unsigned int done = 0;
    unsigned int intr_status = 0;
    printf("Starting to poll counter status...\n");
    printf("Will stop counting when count_value reaches %u\n", count_max / 2);

    while (done == 0) {
        count_value = Xil_In32(IP_BASE_ADDR + 0x04); // Read slv_reg1
        done = Xil_In32(IP_BASE_ADDR + 0x08);        // Read slv_reg2
        intr_status = Xil_In32(INTR_BASE_ADDR + ISR); // Read interrupt status
        printf("[Status] count_value: %u, done: %u, intr_status: %u\n", count_value, done, intr_status);

        // Check if count_value reaches half of count_max
        if (count_value >= count_max / 2 && done == 0) {
            printf("Count reached %u, writing 1 to slv_reg3 to stop counting\n", count_value);
            Xil_Out32(IP_BASE_ADDR + 0x0C, 0x1); // Write to slv_reg3 to trigger stop
        }

        // Check if interrupt is triggered
        if (intr_status & 0x1) {
            printf("Interrupt detected! Acknowledging interrupt...\n");
            Xil_Out32(INTR_BASE_ADDR + IAR, 0x1); // Acknowledge interrupt
            done = 1; // Exit loop
        }

        usleep(500000); // 500ms delay to match ~335ms counting period
    }

    // Step 4: Verify final state
    count_value = Xil_In32(IP_BASE_ADDR + 0x04);
    printf("Counting completed or interrupted!\n");
    printf("Final count_value (should be 0): %u\n", count_value);
    printf("Done flag (should be 1): %u\n", done);

    printf("=== Test Finished ===\n");
    while (1);
    return 0;
}
