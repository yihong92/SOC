#include "xparameters.h"
#include "xuartps.h"
#include "xscugic.h"
#include "xil_exception.h"
#include "xil_io.h"
#include <stdio.h>
#include <sleep.h>
#include <string.h>

#define IP_BASE_ADDR XPAR_HW2_INTERRUPT_0_S00_AXI_BASEADDR // IP 基地址
#define UART_DEVICE_ID XPAR_XUARTPS_0_DEVICE_ID // UART 設備 ID
#define GIC_DEVICE_ID XPAR_PS7_SCUGIC_0_DEVICE_ID // 中斷控制器 ID
#define IRQ_NUM XPAR_FABRIC_HW2_INTERRUPT_0_IRQ_INTR // 中斷編號

XScuGic Intc; // 中斷控制器實例
volatile int interrupted = 0; // 中斷標誌

// 中斷服務程式 (ISR)
void HW2_ISR(void *CallbackRef) {
    printf("IP 已中斷\n"); // 印出中斷訊息
    Xil_Out32(IP_BASE_ADDR + 0x0C, 0x0); // 清除 slv_reg3 (stop)
    interrupted = 1; // 設置中斷標誌
    XScuGic_Disable(&Intc, IRQ_NUM); // 暫時禁用中斷
}

// 初始化中斷控制器
int SetupInterruptSystem() {
    XScuGic_Config *IntcConfig = XScuGic_LookupConfig(GIC_DEVICE_ID); // 查找中斷配置
    if (!IntcConfig) return XST_FAILURE;

    if (XScuGic_CfgInitialize(&Intc, IntcConfig, IntcConfig->CpuBaseAddress) != XST_SUCCESS)
        return XST_FAILURE;

    XScuGic_SetPriorityTriggerType(&Intc, IRQ_NUM, 0xA0, 0x3); // 設置為上升沿觸發
    if (XScuGic_Connect(&Intc, IRQ_NUM, (Xil_InterruptHandler)HW2_ISR, NULL) != XST_SUCCESS)
        return XST_FAILURE;

    XScuGic_Enable(&Intc, IRQ_NUM); // 啟用中斷
    Xil_ExceptionInit();
    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT, (Xil_ExceptionHandler)XScuGic_InterruptHandler, &Intc);
    Xil_ExceptionEnable();
    return XST_SUCCESS;
}

int main() {
    printf("=== AXI IP Counter Test (Button Starts, UART Stops) ===\n"); // 印出程式啟動訊息

    // 初始化中斷系統
    if (SetupInterruptSystem() != XST_SUCCESS) {
        printf("中斷系統初始化失敗\n");
        return XST_FAILURE;
    }
    printf("中斷系統初始化成功\n");

    // 初始化 UART
    XUartPs uart;
    XUartPs_Config *config = XUartPs_LookupConfig(UART_DEVICE_ID);
    XUartPs_CfgInitialize(&uart, config, config->BaseAddress);

    unsigned int count_max = 30; // 最大計數值
    Xil_Out32(IP_BASE_ADDR + 0x00, count_max); // 寫入 slv_reg0 (count_max)
    Xil_Out32(IP_BASE_ADDR + 0x0C, 0x0);       // 清除 slv_reg3 (stop)

    printf("等待按鍵啟動計數...\n");

    int counting_done = 0; // 計數完成標誌
    int stop_sent = 0;     // 停止信號發送標誌

    while (1) {
        if (!counting_done && !stop_sent && !interrupted) { // 僅在計數進行中輪詢
            unsigned int count_val = Xil_In32(IP_BASE_ADDR + 0x04); // 讀取 slv_reg1 (計數值)
            unsigned int done = Xil_In32(IP_BASE_ADDR + 0x08);      // 讀取 slv_reg2 (完成信號)

            printf("[輪詢] count = %u, done = %u\n", count_val, done);

            if (!stop_sent && XUartPs_IsReceiveData(config->BaseAddress)) {
                char ch = XUartPs_RecvByte(config->BaseAddress);
                printf("收到 UART 輸入 (%c)，發送停止信號...\n", ch);
                Xil_Out32(IP_BASE_ADDR + 0x0C, 0x1); // 設置 slv_reg3 (stop = 1)
                stop_sent = 1;
            }

            if (done) {
                counting_done = 1; // 標記計數完成
            }
        }

        // 處理中斷或計數完成後的等待
        if (interrupted || counting_done) {
            if (interrupted) {
                printf("計數暫停。輸入 're' 重啟...\n");
            } else {
                unsigned int count_val = Xil_In32(IP_BASE_ADDR + 0x04);
                printf("計數完成。最終計數 = %u\n", count_val);
                printf("計數結束。輸入 're' 重啟...\n");
            }

            // 檢查 UART 輸入以重啟
            if (XUartPs_IsReceiveData(config->BaseAddress)) {
                char ch = XUartPs_RecvByte(config->BaseAddress);
                static char input_buf[4] = {0};
                static int input_idx = 0;

                if (ch == '\r' || ch == '\n') {
                    input_buf[input_idx] = '\0';
                    if (strcmp(input_buf, "re") == 0) {
                        printf("重新開始計數...\n");
                        Xil_Out32(IP_BASE_ADDR + 0x0C, 0x0); // 清除 stop
                        Xil_Out32(IP_BASE_ADDR + 0x00, count_max); // 重設 count_max
                        counting_done = 0;
                        stop_sent = 0;
                        interrupted = 0;
                        XScuGic_Enable(&Intc, IRQ_NUM); // 重新啟用中斷
                        printf("等待按鍵啟動計數...\n");
                    }
                    input_idx = 0;
                } else if (input_idx < 3) {
                    input_buf[input_idx++] = ch;
                }
            }
        }

        usleep(500000); // 每 0.5 秒檢查一次
    }

    return 0;
}
